<mxfile host="mail-archive" type="device">
  <diagram name="The import pipeline" id="import-pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="source" value="MailSourcePort&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;Gmail · a folder of .eml files&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#A6740A;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="list" value="list_messages(cursor)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;one page of references&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="filter" value="drop what this account already has&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;one IN (…) per page&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="fetch" value="fetch_raw(slice)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;semaphore · 8 streams · 5 retries&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="parse" value="parse + store the bytes&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;stdlib email, in a thread&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="440" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="queue" value="asyncio.Queue&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;a message, or a failure — never nothing&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00707F;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="540" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="consumer" value="the one archive consumer&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;buffers up to batch_size&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00707F;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="640" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="graphwrite" value="1. MessageArchiver&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;graph first, so a crash re-imports&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#3B5BA5;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="740" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="ledger" value="2. record archived and failed&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;one transaction per batch&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#3B5BA5;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="840" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="checkpoint" value="3. checkpoint the cursor&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;every checkpoint_every messages&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="940" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="sqliteread" value="SQLite&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;mail_archived_messages&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="240" width="210" height="58" as="geometry" /></mxCell>
        <mxCell id="blobstore" value="blob store&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;.eml and attachments, by sha256&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="440" width="210" height="58" as="geometry" /></mxCell>
        <mxCell id="graphstore" value="graph&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;nodes and edges&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="740" width="210" height="58" as="geometry" /></mxCell>
        <mxCell id="sqlitewrite" value="SQLite&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;archived · failed · checkpoint&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="890" width="210" height="58" as="geometry" /></mxCell>
