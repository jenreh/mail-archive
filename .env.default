# Configuration profiles are selected per entry point, NOT here.
#
# appkit_commons calls load_dotenv(override=True) at import time, so any key in
# this file beats the real process environment. A PROFILES line here would pin
# every entry point to one profile and silently defeat `PROFILES=... task ...`.
# It is therefore left commented out on purpose.
#
#   task run          -> PROFILES=local  (config.local.yaml: dev, ports 8080/3030)
#   task tauri:dev    -> PROFILES=prod   (config.prod.yaml:  single port 8080, local graph)
#   task tauri:build  -> PROFILES=prod
#   cloud             -> PROFILES=prod plus APP__GRAPH__MODE=remote
#
# Only ONE profile set may be active per process: appkit's YAML reader caches and
# merges in place, so a second merge with different profiles inherits the first.
#PROFILES=local
#PROFILES=prod
#PROFILES=devcontainer

SECRET_PROVIDER=local        # or azure if you want to use Azure Key Vault
AZURE_KEY_VAULT_URL=https://<your-key-vault-name>.vault.azure.net/  # Optional: only needed if SECRET_PROVIDER=azure
REFLEX_SOCKET_TIMEOUT=600     # Optional: increase the timeout for the reflex socket, e.g. if you are using a devcontainer and the reflex server is running on the host machine
UV_PROJECT_ENVIRONMENT=.venv # Optional: if using devcontainer and local development set this e.g. to .venv.mac

#####
# local secret provider:

# The relational store is a SQLite file (configuration/config.yaml), so it needs
# no user, password or host — only the key that encrypts columns inside it.
mn-db-encryption-key=<your fernet encryption key here>
mn-graph-host=<your falkordb host here>

# The desktop OAuth client Gmail mailboxes connect through, from your own
# Google Cloud project: APIs & Services -> Credentials -> OAuth client ID ->
# Desktop app. One client serves every mailbox this installation archives.
mn-google-client-id=<your google oauth client id here>
mn-google-client-secret=<your google oauth client secret here>
