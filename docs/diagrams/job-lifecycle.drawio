<mxfile host="mail-archive" type="device">
  <diagram name="Job lifecycle" id="job-lifecycle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="queued" value="queued&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;waiting for a worker&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00707F;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="180" height="62" as="geometry" /></mxCell>
        <mxCell id="running" value="running&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;worker_id + lease_until&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="200" height="62" as="geometry" /></mxCell>
        <mxCell id="succeeded" value="succeeded" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="690" y="60" width="170" height="54" as="geometry" /></mxCell>
        <mxCell id="failed" value="failed&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;error is recorded&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="690" y="180" width="170" height="54" as="geometry" /></mxCell>
        <mxCell id="cancelled" value="cancelled&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;asked to stop, not killed&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="690" y="300" width="170" height="54" as="geometry" /></mxCell>
        <mxCell id="enqueue" value="enqueue(kind, account)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;UI or scheduler&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#6B3FA0;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="180" height="54" as="geometry" /></mxCell>
        <mxCell id="heartbeat" value="heartbeat every 10 s&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;pushes the lease out&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C9A227;fontColor=#1F2328;fontSize=12;fontStyle=0;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="200" height="54" as="geometry" /></mxCell>
        <mxCell id="expiry" value="lease ran out&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;reclaim_expired()&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C9A227;fontColor=#1F2328;fontSize=12;fontStyle=0;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="200" height="54" as="geometry" /></mxCell>
        <mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="enqueue" target="queued"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge1" value="claim()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="queued" target="running"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="heartbeat" target="running"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="running" target="succeeded"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="running" target="failed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge5" value="cancel_requested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=1.0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="running" target="cancelled"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="running" target="expiry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge7" value="back in the queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="expiry" target="queued"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
