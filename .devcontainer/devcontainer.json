// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "mail-archive-dev",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"remoteUser": "vscode",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"containerEnv": {
		"WORKSPACE": "/workspaces/${localWorkspaceFolderBasename}",
		"UV_PROJECT_ENVIRONMENT": ".venv",
		"VIRTUAL_ENV": "/workspaces/${localWorkspaceFolderBasename}/.venv"
	},
	"mounts": [
		"source=${localEnv:HOME}${env:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
	],
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.envFile": "${workspaceFolder}/.env"
			},
			"extensions": [
				"-dbaeumer.vscode-eslint",
				"-ms-python.autopep8", // disabled because we are using ruff
				"astral-sh.ty",
				"charliermarsh.ruff",
				"esbenp.prettier-vscode",
				"fill-labs.dependi",
				"GitHub.copilot-chat",
				"GitHub.copilot",
				"GitHub.remotehub",
				"github.vscode-github-actions",
				"GitHub.vscode-pull-request-github",
				"humao.rest-client",
				"ms-azuretools.vscode-containers",
				"qwtel.sqlite-viewer",
				"ms-python.python",
				"mutantdino.resourcemonitor",
				"naumovs.color-highlight",
				"redhat.vscode-yaml",
				"sndst00m.vscode-native-svg-preview",
				"tamasfe.even-better-toml",
				"teticio.python-envy",
				"Upstash.context7-mcp",
				"vscode-icons-team.vscode-icons",
				"yzhang.markdown-all-in-one"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2.5.9": {
			"configureZshAsDefaultShell": true,
			"username": "vscode"
		},
		"ghcr.io/devcontainers/features/git:1.3.5": {},
		"ghcr.io/devcontainers/features/github-cli:1.1.0": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {},
		"ghcr.io/devcontainers/features/node:2.0.0": {
			"version": "24"
		}
	},
	"postCreateCommand": {
		"initialize environment": "bash ./.devcontainer/post-create.sh"
	},
	"postAttachCommand": {
		"install dependencies": "uv sync"
	}
}
