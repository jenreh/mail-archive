<mxfile host="mail-archive" type="device">
  <diagram name="Connecting a mailbox" id="account-setup">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="form" value="1. Add the account&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;fields come from the provider descriptor&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#6B3FA0;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="250" height="64" as="geometry" /></mxCell>
        <mxCell id="stored" value="2. Credential stored&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;encrypted column, opaque blob&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="250" height="64" as="geometry" /></mxCell>
        <mxCell id="consent" value="3. Connect&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;verify() — for Gmail, consent&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#6B3FA0;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="250" height="64" as="geometry" /></mxCell>
        <mxCell id="browser" value="Your browser&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;Google's own consent screen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="280" width="230" height="64" as="geometry" /></mxCell>
        <mxCell id="loopback" value="127.0.0.1:&lt;free port&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;one-shot redirect listener&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="280" width="230" height="64" as="geometry" /></mxCell>
        <mxCell id="refresh" value="4. Refresh token saved&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;back into mail_credentials&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="160" width="230" height="64" as="geometry" /></mxCell>
        <mxCell id="identity" value="5. Identity confirmed&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;whose mailbox this really is&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#3B5BA5;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="40" width="230" height="64" as="geometry" /></mxCell>
        <mxCell id="ready" value="6. Ready to import&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot; color=&quot;#57606A&quot;&gt;status: idle&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D46;fontColor=#1F2328;fontSize=12;fontStyle=1;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="230" height="64" as="geometry" /></mxCell>
        <mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="form" target="stored"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="stored" target="consent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="consent" target="browser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge3" value="code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="browser" target="loopback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="loopback" target="refresh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="refresh" target="identity"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=14;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#57606A;fontColor=#57606A;fontSize=11;fontFamily=Helvetica, Arial, sans-serif;labelBackgroundColor=#FFFFFF;dashed=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="identity" target="ready"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
