{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mail-archive",
  "version": "1.0.0",
  "identifier": "de.rehpoehler.mail-archive",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mail-archive",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/falkordb/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
